# Supabase — salin ke .env.local untuk development, dan isi di Vercel untuk production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL publik aplikasi (tanpa slash di akhir). Dipakai untuk isi tautan QR.
# Kosongkan saat development — aplikasi memakai origin browser secara otomatis.
NEXT_PUBLIC_APP_URL=

# === Khusus saat menjalankan `npm run seed` (JANGAN diisi di Vercel) ===
# Service role key Supabase. Hanya dipakai sekali untuk membuat akun massal.
SUPABASE_SERVICE_ROLE_KEY=

# Domain email akun pegawai (default: medanjohor.go.id)
SEED_EMAIL_DOMAIN=medanjohor.go.id

# Opsional — password seragam untuk semua pegawai.
# Jika dikosongkan, setiap pegawai mendapat password acak unik (hasil dicetak di CSV).
SEED_PASSWORD=

# Opsional — akun admin dashboard (default: admin@medanjohor.go.id, password acak dicetak di konsol)
SEED_ADMIN_EMAIL=admin@medanjohor.go.id
SEED_ADMIN_PASSWORD=
